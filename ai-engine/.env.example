AI_APP_NAME=Trivikrama AI Engine
AI_ENVIRONMENT=development
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=INFO
AI_MODELS_DIR=models
AI_REQUIRE_MODEL_ON_STARTUP=false

# Offline training export only. Prefer a read-only MongoDB account.
TRAINING_MONGODB_URI=mongodb://localhost:27017/trivikrama
TRAINING_ORG_ID=replace-with-organization-id
# Set only when TRAINING_MONGODB_URI has no database component.
TRAINING_MONGODB_DATABASE=
TRAINING_MONGODB_TIMEOUT_MS=5000
