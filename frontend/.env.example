# Browser-facing API origin for local development. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000/ws

# Production is same-origin behind nginx.
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NEXT_PUBLIC_WEBSOCKET_URL=wss://siem.example.com/ws
