NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_MAX_SESSION_DURATION=7d

DATABASE_URL=postgresql://siem_app:devpass@localhost:5432/siem_db
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_QUERY_TIMEOUT_MS=30000

MONGODB_URI=mongodb://localhost:27017/siem_events
MONGODB_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=trivikrama

BCRYPT_SALT_ROUNDS=12

COLLECTOR_DIR=./collector
COLLECTOR_HMAC_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

AI_ENGINE_URL=http://localhost:8000
AI_TIMEOUT=5000
AI_BATCH_SIZE=100
AI_THRESHOLD=0.65

FRONTEND_URL=http://localhost:3001

LOG_LEVEL=debug
LOG_FORMAT=pretty