# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql://trivikrama_app:CHANGE_ME@localhost:5432/trivikrama
MIGRATION_DATABASE_URL=postgresql://trivikrama_migrator:CHANGE_ME@localhost:5432/trivikrama
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_QUERY_TIMEOUT_MS=30000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/trivikrama
MONGODB_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=trivikrama

# Authentication foundation (BE-01A)
# Replace the placeholder before startup. JWT_SECRET must be at least 64 characters.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_WITH_AT_LEAST_64_CHARACTERS_BEFORE_STARTING
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_WINDOW=5m
JWT_MAX_SESSION_DURATION=7d
JWT_ISSUER=ai-siem
JWT_COOKIE_NAME=siem_token
# Must be true when NODE_ENV=production.
JWT_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10

# Collector
COLLECTOR_DIR=./collector
COLLECTOR_HMAC_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_WITH_AT_LEAST_64_CHARACTERS_BEFORE_STARTING

# AI engine
AI_ENGINE_URL=http://localhost:8000
AI_TIMEOUT=5000
AI_BATCH_SIZE=100
AI_THRESHOLD=0.65

# Browser origin used by CORS. Production must set an explicit origin.
FRONTEND_URL=http://localhost:3001

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Initial administrator seed (one-time bootstrap)
ADMIN_INITIAL_USERNAME=abhay_admin
ADMIN_INITIAL_EMAIL=admin@example.local
ADMIN_INITIAL_DISPLAY_NAME=Trivikrama Administrator
ADMIN_INITIAL_PASSWORD=CHANGE_ME_BEFORE_RUNNING_THE_INITIAL_ADMIN_SEED
ADMIN_INITIAL_ORG_ID=default
