{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts latest",
    "migrate:status": "tsx src/scripts/migrate.ts status",
    "migrate:rollback": "tsx src/scripts/migrate.ts rollback",
    "migrate:prod": "node dist/src/scripts/migrate.js latest",
    "db:seed": "tsx src/scripts/seed.ts core",
    "db:seed:development": "tsx src/scripts/seed.ts development",
    "db:seed:status": "tsx src/scripts/seed.ts status",
    "db:mongo:status": "tsx src/scripts/mongo-bootstrap.ts status",
    "db:mongo:bootstrap": "tsx src/scripts/mongo-bootstrap.ts apply",
    "db:mongo:bootstrap:prod": "node dist/src/scripts/mongo-bootstrap.js apply",
    "db:redis:status": "tsx src/scripts/redis-verify.ts status",
    "db:redis:verify": "tsx src/scripts/redis-verify.ts verify",
    "db:redis:verify:prod": "node dist/src/scripts/redis-verify.js verify",
    "db:verify:status": "tsx src/scripts/db-verify.ts status",
    "db:verify": "tsx src/scripts/db-verify.ts verify",
    "db:verify:prod": "node dist/src/scripts/db-verify.js verify",
    "db:transaction:smoke": "tsx src/scripts/transaction-smoke.ts",
    "test:repositories:integration": "tsx tests/integration/repositories/run-repository-integration-tests.ts",
    "test:migration:be01a": "node tests/unit/migrations/be-01a-auth-compatibility-migration.test.cjs",
    "test:auth-config": "tsx tests/unit/config/auth-config.test.ts",
    "test:repositories:be01a": "tsx tests/integration/repositories/be-01a-auth-repository-capabilities.integration.ts",
    "test:be01a:foundation": "npm run typecheck && npm run typecheck:be01a-tests && npm run test:migration:be01a && npm run test:auth-config",
    "db:maintenance:status": "tsx src/scripts/db-maintenance.ts status",
    "db:maintenance:partitions": "tsx src/scripts/db-maintenance.ts partitions",
    "db:maintenance:retention": "tsx src/scripts/db-maintenance.ts retention",
    "db:maintenance:vacuum": "tsx src/scripts/db-maintenance.ts vacuum",
    "db:maintenance:run": "tsx src/scripts/db-maintenance.ts run",
    "db:maintenance:prod": "node dist/src/scripts/db-maintenance.js run",
    "db:migrate": "tsx src/scripts/migrate.ts latest",
    "typecheck:be01a-tests": "tsc -p tsconfig.be01a-tests.json",
    "test:auth:be01b": "tsx tests/unit/auth/be01b-auth-infrastructure.test.ts",
    "test:auth:be01b:integration": "tsx tests/integration/auth/be01b-postgres-session-validator.integration.ts",
    "test:auth:be01c": "node --import tsx tests/unit/auth/be01c-auth-application.test.ts && node --import tsx tests/unit/auth/be01c-auth-composition.test.ts",
    "test:auth:be01d": "node --import tsx tests/unit/auth/be01d-auth-verification.test.ts && node --import tsx tests/integration/auth/be01d-auth-http.test.ts",
    "test:build-contract": "node tests/unit/build-contract.test.cjs",
    "verify:build-contract": "node tests/unit/build-contract.test.cjs --verify-dist",
    "test:stb003": "npm run test:build-contract && npm run typecheck && npm run test:auth:be01d && node --import tsx --test tests/unit/shared/http-contract.test.ts tests/unit/users/create-user.http.test.ts tests/unit/users/deactivate-user-by-id.http.test.ts tests/unit/users/get-user-by-id.http.test.ts tests/unit/users/user-mutation.http.test.ts && node --import tsx tests/unit/users/users-http.test.ts",
    "docs:sync": "node scripts/docs-sync.js",
    "test:ingestion:be-ing-01a:primitives": "node --import tsx tests/unit/ingestion/be-ing-01a-security-primitives.test.ts",
    "test:ingestion:be-ing-01a:contract": "node --import tsx tests/unit/ingestion/be-ing-01a-contract-fixtures.test.ts",
    "test:ingestion:be-ing-01a:trust-config": "node --import tsx tests/unit/ingestion/be-ing-01a-trust-configuration.test.ts",
    "test:ingestion:be-ing-01a:configured-composition": "node --import tsx tests/unit/ingestion/be-ing-01a-configured-composition.test.ts",
    "test:ingestion:be-ing-01a": "npm run test:ingestion:be-ing-01a:primitives && npm run test:ingestion:be-ing-01a:contract && npm run test:ingestion:be-ing-01a:trust-config && npm run test:ingestion:be-ing-01a:configured-composition && npm run test:ingestion:be-ing-01a:runtime-wiring",
    "test:ingestion:be-ing-01a:runtime-wiring": "node --import tsx tests/unit/ingestion/be-ing-01a-runtime-wiring.test.ts",
    "test:ingestion:be-ing-01b": "node --import tsx tests/unit/ingestion/be-ing-01b-file-intake.test.ts",
    "test:ingestion:be-ing-01c:unit": "node --import tsx tests/unit/ingestion/be-ing-01c-in-memory-queue.test.ts && node --import tsx tests/unit/ingestion/be-ing-01c-verify-and-queue-claimed-batch.test.ts && node --import tsx tests/unit/ingestion/be-ing-01c-run-collector-intake-cycle.test.ts",
    "test:ingestion:be-ing-01c:integration": "node --import tsx tests/integration/ingestion/be-ing-01c-bullmq-queue.integration.ts && node --import tsx tests/integration/ingestion/be-ing-01c-intake-cycle.integration.test.ts",
    "test:ingestion:be-ing-01c": "npm run test:ingestion:be-ing-01c:unit && npm run test:ingestion:be-ing-01c:integration"
    ,"ingestion:run-once": "tsx src/scripts/run-collector-intake-cycle.ts"
    , "ingestion:worker": "tsx src/scripts/run-collector-processing-worker.ts",
    "test:ingestion:be-ing-01d:unit": "node --import tsx tests/unit/ingestion/be-ing-01d-archive-verified-collector-batch.test.ts && node --import tsx tests/unit/ingestion/be-ing-01d-process-collector-processing-job.test.ts && node --import tsx tests/unit/ingestion/be-ing-01d-quarantine-processing-job.test.ts && node --import tsx tests/unit/ingestion/be-ing-01d-handle-collector-processing-job.test.ts",
    "test:ingestion:be-ing-01d:integration": "node --import tsx tests/integration/ingestion/be-ing-01d-bullmq-worker.integration.test.ts",
    "test:ingestion:be-ing-01d": "npm run test:ingestion:be-ing-01d:unit && npm run test:ingestion:be-ing-01d:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mongoose": "^8.24.1",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
