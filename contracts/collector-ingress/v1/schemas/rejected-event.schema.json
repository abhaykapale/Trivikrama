{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trivikrama:collector-ingress:1.0.0:rejected-event",
  "title": "Trivikrama Collector Rejected Event 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "rejection_id",
    "collector_id",
    "rejected_at",
    "source",
    "rejection",
    "payload",
    "integrity"
  ],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "message_type": {
      "const": "rejected_event"
    },
    "rejection_id": {
      "$ref": "common.schema.json#/$defs/uuidV4"
    },
    "collector_id": {
      "$ref": "common.schema.json#/$defs/collectorId"
    },
    "rejected_at": {
      "$ref": "common.schema.json#/$defs/rfc3339UtcMillis"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "adapter_type",
        "file_identity",
        "record_start_offset",
        "record_end_offset"
      ],
      "properties": {
        "source_id": {
          "$ref": "common.schema.json#/$defs/sourceId"
        },
        "adapter_type": {
          "const": "file"
        },
        "file_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record_start_offset": {
          "$ref": "common.schema.json#/$defs/safeInteger"
        },
        "record_end_offset": {
          "$ref": "common.schema.json#/$defs/safeInteger"
        }
      }
    },
    "rejection": {
      "$ref": "#/$defs/rejection"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "byte_length",
        "sha256",
        "capture_encoding",
        "capture",
        "capture_truncated"
      ],
      "properties": {
        "content_type": {
          "enum": ["application/json", "application/octet-stream"]
        },
        "byte_length": {
          "$ref": "common.schema.json#/$defs/safeInteger"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "capture_encoding": {
          "const": "base64"
        },
        "capture": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 87384
        },
        "capture_truncated": {
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "$ref": "common.schema.json#/$defs/integrity"
    }
  },
  "$defs": {
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "message"],
      "properties": {
        "stage": {
          "enum": ["input_validation", "mapping", "ocsf_validation"]
        },
        "code": {
          "enum": [
            "invalid_json",
            "invalid_utf8",
            "missing_required_field",
            "invalid_field_type",
            "invalid_timestamp",
            "invalid_ip_address",
            "unsupported_event_type",
            "record_too_large",
            "mapping_failed",
            "ocsf_validation_failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "stage": { "const": "input_validation" } },
            "required": ["stage"]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_json",
                  "invalid_utf8",
                  "missing_required_field",
                  "invalid_field_type",
                  "invalid_timestamp",
                  "invalid_ip_address",
                  "unsupported_event_type",
                  "record_too_large"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "stage": { "const": "mapping" } },
            "required": ["stage"]
          },
          "then": {
            "properties": { "code": { "const": "mapping_failed" } }
          }
        },
        {
          "if": {
            "properties": { "stage": { "const": "ocsf_validation" } },
            "required": ["stage"]
          },
          "then": {
            "properties": { "code": { "const": "ocsf_validation_failed" } }
          }
        }
      ]
    }
  }
}
