# Historical implementation copies, never source roots
/*-backup*/
/*-extracted/
/*-upload-*/
/install-safety-*/
/*.before-*
/.repo-sync/
/.maintenance/
/tracking-removals.local.txt

# Local inventory and shell diagnostic output
/deleted-files.txt
/git-diff.txt
/git-status.txt
/github-inventory.txt
/repository-inventory.json
/staged-changes.txt
/unstaged-changes.txt
/untracked-files.txt
/backend/repository-inventory.json

# Proof evidence and local model training output
/backend/artifacts/
/ai-engine/proof_runs/
/ai-engine/training_data/*
!/ai-engine/training_data/README.md

# Collector queues, checkpoints, and signed runtime payloads
/collector/runtime/
/collector/incoming/
/collector/processing/
/collector/processed/
/collector/quarantine/
# Preserve documented empty-directory markers and contract fixtures.
!/collector/runtime/
/collector/runtime/*
!/collector/runtime/.gitkeep
!/collector/incoming/
/collector/incoming/*
!/collector/incoming/.gitkeep
!/collector/processing/
/collector/processing/*
!/collector/processing/.gitkeep
!/collector/processed/
/collector/processed/*
!/collector/processed/.gitkeep
!/collector/quarantine/
/collector/quarantine/*
!/collector/quarantine/.gitkeep
**/tests/fixtures/config/runtime/logs/*
!**/tests/fixtures/config/runtime/logs/
!**/tests/fixtures/config/runtime/logs/.gitkeep
